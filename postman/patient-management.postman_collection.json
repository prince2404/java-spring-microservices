{
  "info": {
    "_postman_id": "5c01f0ce-cc6e-4f8e-941c-803cef0b8995",
    "name": "Patient Management - Local Docker",
    "description": "Run these requests in order after selecting the Patient Management Local environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4004",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (saves JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", function () {", 
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.environment.set(\"jwt\", response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@test.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Validate saved JWT",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{baseUrl}}/auth/validate"
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Get patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{baseUrl}}/api/patients"
          }
        },
        {
          "name": "Create patient (saves patient ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Patient is created\", function () {", 
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const response = pm.response.json();",
                  "if (response.id) {",
                  "    pm.environment.set(\"patientId\", response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Patient\",\n  \"email\": \"postman-{{$timestamp}}@example.com\",\n  \"address\": \"1 Docker Lane\",\n  \"dateOfBirth\": \"1995-06-15\",\n  \"registeredDate\": \"2026-10-26\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/patients"
          }
        },
        {
          "name": "Update saved patient",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Updated Patient\",\n  \"email\": \"postman-updated-{{$timestamp}}@example.com\",\n  \"address\": \"2 Gateway Street\",\n  \"dateOfBirth\": \"1995-06-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/patients/{{patientId}}"
          }
        },
        {
          "name": "Delete saved patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Patient is deleted\", function () {", 
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": "{{baseUrl}}/api/patients/{{patientId}}"
          }
        }
      ]
    }
  ]
}
